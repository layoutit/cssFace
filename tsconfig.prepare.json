{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": ".build/prepare"
  },
  "files": [
    "src/adapters/facesjs/model-package/componentCatalog.ts",
    "src/adapters/facesjs/model-package/componentPackage.ts",
    "src/adapters/facesjs/player/componentRuntime.ts",
    "src/adapters/facesjs/player/configTransforms.ts",
    "src/adapters/facesjs/player/faceConfigResolver.ts",
    "src/adapters/facesjs/player/materialColors.ts",
    "src/adapters/facesjs/preview/facesJsSnippet.ts",
    "src/adapters/facesjs/scripts/prepare.mjs"
  ]
}
